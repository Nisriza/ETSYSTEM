# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PERSISTENT SUPABASE POSTGRESQL / DATABASE CONNECTION (Recommended)
# Format for project kirltxcnlunlhgtaafjs (ap-northeast-2):
# SUPABASE_DB_URL="postgresql://postgres.kirltxcnlunlhgtaafjs:[YOUR_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"
SUPABASE_DB_URL="https://kirltxcnlunlhgtaafjs.supabase.co"

# CLIENT-SIDE SUPABASE CREDENTIALS (Optional for JS API/Storage calls)
VITE_SUPABASE_URL="https://kirltxcnlunlhgtaafjs.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_263cmxRN6_LVZFsbQCLqzw_QZ7tlM8H"

# PERSISTENT MYSQL DATABASE (Optional)
# If provided, the Cloud Run applet will connect to this MySQL instance.
# Otherwise, it automatically falls back to a highly reliable local SQLite database (ets_system.db).
# NOTE: "127.0.0.1" inside the Cloud container refers to the container itself.
# To connect to your local PC's XAMPP MySQL, use a public IP, Ngrok, or host the database on the cloud.
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ets_system
