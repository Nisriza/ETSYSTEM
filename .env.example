# ==========================================
# ETS Rider Predict System - environment variables
# ==========================================
# Local setup: copy this file to `.env.local` and fill in real values.
# `.env.local` overrides `.env` and is git-ignored.
#
# On the API host (Render/Railway/Fly) set the server variables in the
# dashboard. On Vercel set only the VITE_* client variables (they are baked
# into the bundle at build time).
# ==========================================

# --- Supabase (server) ------------------------------------------------
# Required. Used by src/db/sqlite.ts through the `exec_sql` RPC.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional. Used by the Google auth bridge to verify Supabase access tokens
# (the service-role key also works, but the anon key is the least privileged).
SUPABASE_ANON_KEY="your-anon-key"

# --- Supabase (client, public) ----------------------------------------
# Required for "Sign in with Google". Safe to expose: the anon key is public.
# On Vercel these two must be set in Project Settings -> Environment Variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# --- API location -----------------------------------------------------
# Leave EMPTY for local development (Vite proxies to the Express server that
# runs in the same process).
# Set to the public API origin when the SPA is hosted separately (e.g. Vercel):
#   VITE_API_BASE_URL="https://ets-rider-api.onrender.com"
VITE_API_BASE_URL=""

# --- CORS (server, production only) -----------------------------------
# Comma-separated allowlist of browser origins allowed to call the API.
#   CORS_ORIGINS="https://ets-rider.vercel.app,http://localhost:3000"
CORS_ORIGINS=""

# --- AI Assistant (optional) ------------------------------------------
# Leave blank to disable the floating AI assistant.
GEMINI_API_KEY=""

# --- Server port (optional) -------------------------------------------
# Render/Railway inject PORT automatically; local default is 3000.
# PORT=3000
